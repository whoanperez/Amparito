# Copia este archivo a .env.local y rellena los valores.
# (.env.local está en .gitignore — nunca se sube.)

# ── Requerido: el cerebro conversacional (Claude Haiku) ──────────────────────
ANTHROPIC_API_KEY=
# Opcional (por defecto claude-haiku-4-5):
# ANTHROPIC_MODEL=claude-haiku-4-5

# ── Bloque 4 · Voz (Gemini Live) — APAGADO por defecto ───────────────────────
# Deja esto en "false" (o sin definir) para el comportamiento normal del chat.
# Ponlo en "true" SOLO cuando quieras validar la voz. Al prenderlo aparece el
# micrófono y Amparito habla; requiere las dos keys de abajo. Tras cambiarlo,
# reinicia el dev server (Next inyecta las NEXT_PUBLIC_* en build).
NEXT_PUBLIC_VOICE_ENABLED=false

# Key de Google/Gemini (SERVER-ONLY: NO lleva prefijo NEXT_PUBLIC, no se expone
# al navegador). Se usa solo para acuñar tokens efímeros en /api/live-token.
GEMINI_API_KEY=
# Opcional (modelo Live; ajústalo al vigente cuando valides):
# GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001

# ── Arranque caliente de afiliados (opcional) ────────────────────────────────
# SIN esto, la app usa un sample local sintético (el arranque caliente funciona
# en el demo con Carolina/Andrés/Jaime). Para el deploy con TODA la base:
#   1) Crea una BD gratis en https://turso.tech (New Database).
#   2) Carga la base:  TURSO_DATABASE_URL=... TURSO_AUTH_TOKEN=... \
#        npx tsx scripts/load-afiliados.ts "/ruta/al/CSV"
#   3) Pon estas dos variables aquí y en Vercel (son SERVER-ONLY, no NEXT_PUBLIC):
# TURSO_DATABASE_URL=libsql://tu-base.turso.io
# TURSO_AUTH_TOKEN=
